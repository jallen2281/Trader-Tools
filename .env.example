# Ollama Configuration
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2-vision
OLLAMA_TIMEOUT=120

# AI Analysis Mode
# USE_VISION=True   # Slower but analyzes chart images (requires llama3.2-vision)
USE_VISION=False    # Faster, text-only analysis (recommended for speed)
FALLBACK_MODEL=llama3.2

# Flask Configuration
FLASK_PORT=5000
FLASK_DEBUG=True

# Default Stock Settings
DEFAULT_SYMBOL=AAPL
DEFAULT_PERIOD=6mo
DEFAULT_INTERVAL=1d

# Plaid — bank/brokerage connections (optional).
# PLAID_ENV is 'sandbox' or 'production'.
# PLAID_ENCRYPTION_KEY encrypts stored access tokens at rest; without it the app refuses
# to start a bank connection. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
PLAID_PRODUCTS=transactions
PLAID_ENCRYPTION_KEY=
